<Window x:Class="GoGame.FeedbackWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource FbTitle}" Height="700" Width="820"
        WindowStartupLocation="CenterOwner"
        Background="#F8F4EA"
        FontFamily="Segoe UI"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        WindowStyle="SingleBorderWindow">

    <!-- ============== Resource styles ============== -->
    <Window.Resources>
        <!-- Single-line input -->
        <Style TargetType="TextBox" x:Key="Input">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D9D2C0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="AcceptsReturn" Value="False"/>
            <Setter Property="TextWrapping" Value="NoWrap"/>
        </Style>

        <!-- Multi-line input -->
        <Style TargetType="TextBox" x:Key="MultiLineInput" BasedOn="{StaticResource Input}">
            <Setter Property="VerticalContentAlignment" Value="Top"/>
            <Setter Property="AcceptsReturn" Value="True"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="MinHeight" Value="180"/>
            <Setter Property="MaxHeight" Value="320"/>
        </Style>

        <!-- Category card (RadioButton custom template) -->
        <Style TargetType="RadioButton" x:Key="CategoryCard">
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#333"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="White"
                                BorderBrush="#E0DAC6" BorderThickness="1"
                                CornerRadius="6" Padding="14,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="IconTxt" Grid.Column="0" Text="{TemplateBinding Tag}"
                                           FontSize="20" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <ContentPresenter Grid.Column="1" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FBF6E8"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#C8B47A"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FBF0D4"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#C8964F"/>
                                <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary button (submit) -->
        <Style TargetType="Button" x:Key="PrimaryBtn">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="6" Padding="28,10" Background="#C8964F">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#B07F38"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#8F6427"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#C8BFA8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary button (cancel) -->
        <Style TargetType="Button" x:Key="GhostBtn">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#666"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="6" Padding="22,10" Background="Transparent"
                                BorderBrush="#D9D2C0" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F0EBDC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Padding="0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ============== Top banner (dark wood) ============== -->
            <Border Grid.Row="0">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#2B2014" Offset="0"/>
                        <GradientStop Color="#4A331C" Offset="0.5"/>
                        <GradientStop Color="#2B2014" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Border Padding="32,22">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="●" FontSize="22" Foreground="#F5E6C8" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="○" FontSize="18" Foreground="#F5E6C8" VerticalAlignment="Center" Margin="0,0,14,0"/>
                            <TextBlock Text="{DynamicResource FbBannerTitle}" FontSize="26" FontWeight="SemiBold" Foreground="#F5E6C8"/>
                            <TextBlock Text="{DynamicResource FbBannerSub}" FontSize="14" Foreground="#DCC68B" VerticalAlignment="Bottom" Margin="4,0,0,5"/>
                        </StackPanel>
                        <TextBlock Text="{DynamicResource FbBannerDesc}"
                                   FontSize="13" Foreground="#C8B47A" Margin="50,4,0,0"/>
                    </StackPanel>
                </Border>
            </Border>

            <!-- ============== Body (two columns) ============== -->
            <Grid Grid.Row="1" Margin="32,24,32,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="240"/>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left: category cards -->
                <StackPanel Grid.Column="0">
                    <TextBlock Text="{DynamicResource FbCatTitle}" FontSize="13" Foreground="#666" Margin="2,0,0,10" FontWeight="SemiBold"/>
                    <RadioButton x:Name="CatKataGo" Style="{StaticResource CategoryCard}" Tag="🐢" GroupName="Cat" IsChecked="True">
                        <TextBlock Text="{DynamicResource FbCatKataGo}" FontSize="14" FontWeight="SemiBold"/>
                        <RadioButton.ToolTip>
                            <TextBlock Text="{DynamicResource FbCatKataGoTip}"/>
                        </RadioButton.ToolTip>
                    </RadioButton>
                    <RadioButton x:Name="CatUi" Style="{StaticResource CategoryCard}" Tag="🖱️" GroupName="Cat">
                        <TextBlock Text="{DynamicResource FbCatUi}" FontSize="14" FontWeight="SemiBold"/>
                        <RadioButton.ToolTip>
                            <TextBlock Text="{DynamicResource FbCatUiTip}"/>
                        </RadioButton.ToolTip>
                    </RadioButton>
                    <RadioButton x:Name="CatReview" Style="{StaticResource CategoryCard}" Tag="📜" GroupName="Cat">
                        <TextBlock Text="{DynamicResource FbCatReview}" FontSize="14" FontWeight="SemiBold"/>
                        <RadioButton.ToolTip>
                            <TextBlock Text="{DynamicResource FbCatReviewTip}"/>
                        </RadioButton.ToolTip>
                    </RadioButton>
                    <RadioButton x:Name="CatLearn" Style="{StaticResource CategoryCard}" Tag="🧩" GroupName="Cat">
                        <TextBlock Text="{DynamicResource FbCatLearn}" FontSize="14" FontWeight="SemiBold"/>
                        <RadioButton.ToolTip>
                            <TextBlock Text="{DynamicResource FbCatLearnTip}"/>
                        </RadioButton.ToolTip>
                    </RadioButton>
                    <RadioButton x:Name="CatInstall" Style="{StaticResource CategoryCard}" Tag="📦" GroupName="Cat">
                        <TextBlock Text="{DynamicResource FbCatInstall}" FontSize="14" FontWeight="SemiBold"/>
                        <RadioButton.ToolTip>
                            <TextBlock Text="{DynamicResource FbCatInstallTip}"/>
                        </RadioButton.ToolTip>
                    </RadioButton>
                    <RadioButton x:Name="CatOther" Style="{StaticResource CategoryCard}" Tag="💭" GroupName="Cat">
                        <TextBlock Text="{DynamicResource FbCatOther}" FontSize="14" FontWeight="SemiBold"/>
                        <RadioButton.ToolTip>
                            <TextBlock Text="{DynamicResource FbCatOtherTip}"/>
                        </RadioButton.ToolTip>
                    </RadioButton>
                </StackPanel>

                <!-- Right: form -->
                <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock FontSize="13" Foreground="#666" Margin="2,0,0,10" FontWeight="SemiBold">
                            <Run Text="{DynamicResource FbTitleLabel}"/>
                            <Run Text=" *" Foreground="#C8964F"/>
                        </TextBlock>
                        <TextBox x:Name="TitleBox" Style="{StaticResource Input}" MaxLength="120"
                                 Tag="{DynamicResource FbTitlePlaceholder}"/>
                        <TextBlock x:Name="TitleCount" Text="0 / 120" FontSize="11" Foreground="#999"
                                   HorizontalAlignment="Right" Margin="0,4,4,0"/>

                        <TextBlock FontSize="13" Foreground="#666" Margin="2,16,0,10" FontWeight="SemiBold">
                            <Run Text="{DynamicResource FbDetailLabel}"/>
                            <Run Text="{DynamicResource FbOptional}" Foreground="#999" FontWeight="Normal"/>
                        </TextBlock>
                        <TextBox x:Name="DetailBox" Style="{StaticResource MultiLineInput}"
                                 Tag="{DynamicResource FbDetailPlaceholder}"/>

                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" FontSize="13" Foreground="#666" Margin="2,0,0,10" FontWeight="SemiBold">
                                <Run Text="{DynamicResource FbEmailLabel}"/>
                                <Run Text="{DynamicResource FbOptional}" Foreground="#999" FontWeight="Normal"/>
                            </TextBlock>
                            <TextBlock Grid.Row="0" Grid.Column="2" FontSize="13" Foreground="#666" Margin="2,0,0,10" FontWeight="SemiBold">
                                <Run Text="{DynamicResource FbSteamLabel}"/>
                                <Run Text="{DynamicResource FbOptional}" Foreground="#999" FontWeight="Normal"/>
                            </TextBlock>
                            <TextBox Grid.Row="1" Grid.Column="0" x:Name="EmailBox" Style="{StaticResource Input}"/>
                            <TextBox Grid.Row="1" Grid.Column="2" x:Name="SteamBox" Style="{StaticResource Input}"/>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- ============== Bottom buttons ============== -->
            <Border Grid.Row="2" Padding="32,8,32,22" Background="#F8F4EA">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock x:Name="HintText" Text="{DynamicResource FbHint}"
                               FontSize="11" Foreground="#999" VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <Button Content="{DynamicResource FbCancel}" Style="{StaticResource GhostBtn}" Click="Cancel_Click" Margin="0,0,8,0"/>
                    <Button x:Name="SubmitBtn" Content="{DynamicResource FbSubmit}" Style="{StaticResource PrimaryBtn}" Click="Submit_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
