<Window x:Class="GoGame.MailConfigDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configure Feedback Email" Height="620" Width="640"
        WindowStartupLocation="CenterOwner"
        Background="#F8F4EA"
        FontFamily="Segoe UI"
        TextOptions.TextFormattingMode="Display"
        WindowStyle="SingleBorderWindow">

    <Window.Resources>
        <Style TargetType="TextBox" x:Key="Input">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D9D2C0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="Button" x:Key="PrimaryBtn">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="6" Padding="22,10" Background="#C8964F">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#B07F38"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#C8BFA8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button" x:Key="GhostBtn">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#666"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="6" Padding="22,10" Background="Transparent"
                                BorderBrush="#D9D2C0" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F0EBDC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="📮 Configure Feedback Email" FontSize="22" FontWeight="SemiBold" Foreground="#2B2014"/>
            <TextBlock Text="Send feedback straight to the developer email (QQ mail SMTP)" FontSize="13" Foreground="#8F6427" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Instructions -->
        <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="20,18" BorderBrush="#E0DAC6" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="How to get your QQ mail &quot;authorization code&quot;" FontSize="14" FontWeight="SemiBold" Foreground="#2B2014" Margin="0,0,0,10"/>

                <TextBlock Text="(An authorization code is NOT your QQ password — it is the 16-character SMTP credential for QQ mail)" FontSize="11" Foreground="#999" Margin="0,0,0,12"/>

                <StackPanel>
                    <TextBlock FontSize="13" Foreground="#444" Margin="0,0,0,6">
                        <Run Text="① "/><Run Text="Open mail.qq.com in a desktop browser" FontWeight="SemiBold"/><Run Text=" and log into your QQ mailbox"/>
                    </TextBlock>
                    <TextBlock FontSize="13" Foreground="#444" Margin="0,0,0,6">
                        <Run Text="② "/><Run Text="Top &quot;Settings&quot;" FontWeight="SemiBold"/><Run Text=" → &quot;Account&quot; tab"/>
                    </TextBlock>
                    <TextBlock FontSize="13" Foreground="#444" Margin="0,0,0,6">
                        <Run Text="③ "/><Run Text="Scroll down to &quot;POP3/IMAP/SMTP/Exchange/CardDAV/CalDAV services&quot;" FontWeight="SemiBold"/>
                    </TextBlock>
                    <TextBlock FontSize="13" Foreground="#444" Margin="0,0,0,6">
                        <Run Text="④ "/><Run Text="Enable &quot;SMTP service&quot;" FontWeight="SemiBold"/><Run Text=" (SMS verification may be required)"/>
                    </TextBlock>
                    <TextBlock FontSize="13" Foreground="#444" Margin="0,0,0,16">
                        <Run Text="⑤ "/><Run Text="Click &quot;Generate authorization code&quot;" FontWeight="SemiBold"/><Run Text=", send the SMS as prompted, and get the 16-character code"/>
                    </TextBlock>
                </StackPanel>

                <TextBlock Text="Paste the authorization code you got below:" FontSize="13" Foreground="#666" Margin="0,0,0,8"/>

                <PasswordBox x:Name="AuthBox" FontSize="14" Padding="10,8" Height="38"
                             Background="White" BorderBrush="#D9D2C0" BorderThickness="1"
                             PasswordChar="●"/>

                <TextBlock x:Name="HintText" Text="" FontSize="12" Foreground="#666" Margin="0,10,0,0" TextWrapping="Wrap"/>

                <CheckBox x:Name="ShowPwdCheck" Content="Show password" Margin="0,10,0,0"
                          Foreground="#666" FontSize="12" Cursor="Hand"
                          Checked="ShowPwd_Checked" Unchecked="ShowPwd_Unchecked"/>
            </StackPanel>
        </Border>

        <!-- Bottom buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" Style="{StaticResource GhostBtn}" Margin="0,0,8,0" Click="Cancel_Click"/>
            <Button x:Name="TestBtn" Content="🔌 Save & Test" Style="{StaticResource PrimaryBtn}" Click="Test_Click"/>
        </StackPanel>
    </Grid>
</Window>
