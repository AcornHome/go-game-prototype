<Window x:Class="GoGame.ReviewReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource ReviewTitle}"
        Height="720" Width="900"
        MinHeight="600" MinWidth="780"
        WindowStartupLocation="CenterOwner"
        Background="#1E2620" FontFamily="Segoe UI, Microsoft YaHei UI"
        Foreground="#F0F2EE">
    <Window.Resources>
        <SolidColorBrush x:Key="BrushPanel"     Color="#243029"/>
        <SolidColorBrush x:Key="BrushCard"      Color="#2D3A32"/>
        <SolidColorBrush x:Key="BrushCardHi"    Color="#354539"/>
        <SolidColorBrush x:Key="BrushText"      Color="#F0F2EE"/>
        <SolidColorBrush x:Key="BrushTextDim"   Color="#9CA89F"/>
        <SolidColorBrush x:Key="BrushAccent"    Color="#E89B3C"/>
        <SolidColorBrush x:Key="BrushDanger"    Color="#D8584A"/>
        <SolidColorBrush x:Key="BrushHuman"     Color="#8FBE6F"/>
        <SolidColorBrush x:Key="BrushAI"        Color="#5BA0D0"/>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource BrushText}"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top: title + summary -->
        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="{DynamicResource ReviewTitle}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource BrushAccent}"/>
            <TextBlock x:Name="SummaryText" Text="" Foreground="{StaticResource BrushTextDim}" FontSize="12" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Second row: turning-point hint (brilliant / blunder) -->
        <Border Grid.Row="1" Background="{StaticResource BrushCard}" CornerRadius="6" Padding="14,10" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="{DynamicResource ReviewKeyPoints}" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource BrushAccent}"/>
                <TextBlock x:Name="KeyPointsText" Text="" Foreground="{StaticResource BrushText}"
                           FontSize="13" Margin="0,6,0,0" TextWrapping="Wrap" LineHeight="20"/>
            </StackPanel>
        </Border>

        <!-- Third row: win-rate curve Canvas + per-move table -->
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="220"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="{DynamicResource ReviewWinrate}"
                       FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource BrushAccent}"
                       Margin="0,0,0,8"/>

            <!-- Win-rate curve Canvas -->
            <Border Grid.Row="1" Background="{StaticResource BrushCard}" CornerRadius="6" Padding="10">
                <Canvas x:Name="ChartCanvas" Background="Transparent" ClipToBounds="True"
                        SizeChanged="ChartCanvas_SizeChanged"/>
            </Border>

            <TextBlock Grid.Row="2" Text="{DynamicResource ReviewMoves}"
                       FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource BrushAccent}"
                       Margin="0,12,0,8"/>

            <!-- Table -->
            <Border Grid.Row="3" Background="{StaticResource BrushCard}" CornerRadius="6" Padding="0">
                <DataGrid x:Name="MovesGrid"
                          AutoGenerateColumns="False"
                          Background="Transparent"
                          Foreground="{StaticResource BrushText}"
                          BorderThickness="0"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#1A201C"
                          CanUserAddRows="False" CanUserDeleteRows="False"
                          CanUserResizeRows="False" CanUserSortColumns="False"
                          IsReadOnly="True" SelectionMode="Single"
                          RowHeight="32" ColumnHeaderHeight="34"
                          RowBackground="Transparent"
                          AlternatingRowBackground="#243029">
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#354539"/>
                            <Setter Property="Foreground" Value="#E89B3C"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="BorderBrush" Value="#1A201C"/>
                            <Setter Property="BorderThickness" Value="0,0,1,1"/>
                            <Setter Property="Padding" Value="10,8"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Padding" Value="10,4"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="DataGridCell">
                                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </DataGrid.CellStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{DynamicResource ReviewColIndex}"  Binding="{Binding IndexLabel}"  Width="70"/>
                        <DataGridTextColumn Header="{DynamicResource ReviewColSide}"   Binding="{Binding SideLabel}"    Width="80"/>
                        <DataGridTextColumn Header="{DynamicResource ReviewColVertex}" Binding="{Binding Vertex}"       Width="100"/>
                        <DataGridTextColumn Header="{DynamicResource ReviewColWinrate}" Binding="{Binding WinrateLabel}" Width="110"/>
                        <DataGridTextColumn Header="{DynamicResource ReviewColLead}"  Binding="{Binding LeadLabel}"    Width="110"/>
                        <DataGridTextColumn Header="{DynamicResource ReviewColDelta}"  Binding="{Binding DeltaLabel}"   Width="110"/>
                        <DataGridTextColumn Header="{DynamicResource ReviewColVerdict}" Binding="{Binding Verdict}"      Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>

        <!-- Bottom: close button -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="{DynamicResource ReviewClose}" Height="38" Padding="24,0" FontSize="13"
                    Background="#354539" Foreground="#F0F2EE" BorderBrush="#3D4A40" BorderThickness="1"
                    Click="Close_Click" Cursor="Hand"/>
        </StackPanel>
    </Grid>
</Window>
