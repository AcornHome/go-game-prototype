<Window x:Class="GoGame.StyledMessageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Notice"
        Background="#1E2620"
        FontFamily="Segoe UI"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner"
        MinWidth="440" MaxWidth="640"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        SnapsToDevicePixels="True">
    <Window.Resources>
        <ResourceDictionary>
            <SolidColorBrush x:Key="BrushBg"        Color="#1E2620"/>
            <SolidColorBrush x:Key="BrushPanel"     Color="#243029"/>
            <SolidColorBrush x:Key="BrushCard"      Color="#2D3A32"/>
            <SolidColorBrush x:Key="BrushCardHi"    Color="#354539"/>
            <SolidColorBrush x:Key="BrushDivider"   Color="#1A201C"/>
            <SolidColorBrush x:Key="BrushText"      Color="#F0F2EE"/>
            <SolidColorBrush x:Key="BrushTextDim"   Color="#9CA89F"/>
            <SolidColorBrush x:Key="BrushAccent"    Color="#E89B3C"/>
            <SolidColorBrush x:Key="BrushAccentDim" Color="#9A6B2C"/>
            <SolidColorBrush x:Key="BrushDanger"    Color="#D8584A"/>

            <Style x:Key="BtnBase" TargetType="Button">
                <Setter Property="Background" Value="{StaticResource BrushCardHi}"/>
                <Setter Property="Foreground" Value="{StaticResource BrushText}"/>
                <Setter Property="BorderBrush" Value="#3D4A40"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Height" Value="42"/>
                <Setter Property="MinWidth" Value="96"/>
                <Setter Property="Padding" Value="16,0"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  Margin="{TemplateBinding Padding}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#45524A"/>
                                    <Setter TargetName="border" Property="BorderBrush" Value="#5A6B5E"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#364039"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="BtnPrimary" TargetType="Button" BasedOn="{StaticResource BtnBase}">
                <Setter Property="Background" Value="#C77F25"/>
                <Setter Property="Foreground" Value="#FFF5E2"/>
                <Setter Property="BorderBrush" Value="{StaticResource BrushAccent}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Height" Value="44"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1" CornerRadius="8">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  Margin="{TemplateBinding Padding}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="{StaticResource BrushAccent}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#A8681D"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="BtnDanger" TargetType="Button" BasedOn="{StaticResource BtnBase}">
                <Setter Property="Background" Value="#8B3A2F"/>
                <Setter Property="Foreground" Value="#FFE4DE"/>
                <Setter Property="BorderBrush" Value="{StaticResource BrushDanger}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Height" Value="44"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1" CornerRadius="8">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  Margin="{TemplateBinding Padding}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#A8483C"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#6F2D24"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Border x:Name="RootBorder" Margin="14" Background="{StaticResource BrushPanel}"
            BorderBrush="{StaticResource BrushAccent}" BorderThickness="2" CornerRadius="12"
            Padding="28,24">
        <StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                <TextBlock x:Name="DialogIcon" Text="" FontSize="26"
                           Foreground="{StaticResource BrushAccent}"
                           VerticalAlignment="Center" Margin="0,0,12,0"/>
                <TextBlock x:Name="DialogTitle" Text=""
                           Foreground="{StaticResource BrushAccent}" FontSize="19"
                           FontWeight="Bold" VerticalAlignment="Center"/>
            </StackPanel>
            <Border Background="#1A201C" CornerRadius="8" Padding="16,14" Margin="0,0,0,20">
                <TextBlock x:Name="DialogMessage" Text=""
                           Foreground="{StaticResource BrushText}" FontSize="13"
                           TextWrapping="Wrap" LineHeight="20"/>
            </Border>
            <StackPanel x:Name="ButtonPanel" Orientation="Horizontal" HorizontalAlignment="Right"/>
        </StackPanel>
    </Border>
</Window>
