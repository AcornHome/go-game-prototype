<Window x:Class="GoGame.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:GoGame"
        Title="{DynamicResource AppTitle}" Height="860" Width="1240"
        MinHeight="680" MinWidth="1040"
        WindowStartupLocation="CenterScreen"
        Background="#1E2620" FontFamily="Segoe UI, Microsoft YaHei UI">
    <Window.Resources>
        <!-- 主色调：墨绿系；强调色：琥珀金；危险色：珊瑚红 -->
        <SolidColorBrush x:Key="BrushBg"        Color="#1E2620"/>
        <SolidColorBrush x:Key="BrushPanel"     Color="#243029"/>
        <SolidColorBrush x:Key="BrushCard"      Color="#2D3A32"/>
        <SolidColorBrush x:Key="BrushCardHi"    Color="#354539"/>
        <SolidColorBrush x:Key="BrushDivider"   Color="#1A201C"/>
        <SolidColorBrush x:Key="BrushText"      Color="#F0F2EE"/>
        <SolidColorBrush x:Key="BrushTextDim"   Color="#9CA89F"/>
        <SolidColorBrush x:Key="BrushTextMute"  Color="#6F7B73"/>
        <SolidColorBrush x:Key="BrushAccent"    Color="#E89B3C"/>
        <SolidColorBrush x:Key="BrushAccentDim" Color="#9A6B2C"/>
        <SolidColorBrush x:Key="BrushDanger"    Color="#D8584A"/>
        <SolidColorBrush x:Key="BrushAI"        Color="#5BA0D0"/>
        <SolidColorBrush x:Key="BrushHuman"     Color="#8FBE6F"/>

        <!-- 通用控件样式 -->
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource BrushText}"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="{StaticResource BrushCardHi}"/>
            <Setter Property="Foreground" Value="{StaticResource BrushText}"/>
            <Setter Property="BorderBrush" Value="#3D4A40"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Background="{TemplateBinding Background}"
                                          Foreground="{TemplateBinding Foreground}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}"
                                          IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press" Focusable="False">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="border"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="4">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="28"/>
                                                </Grid.ColumnDefinitions>
                                                <ContentPresenter Grid.Column="0" Margin="10,0,0,0"
                                                                  VerticalAlignment="Center" HorizontalAlignment="Left"/>
                                                <Path Grid.Column="1" x:Name="arrow"
                                                      Data="M 0 0 L 4 4 L 8 0 Z"
                                                      Fill="{StaticResource BrushTextDim}"
                                                      VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="border" Property="Background" Value="#45524A"/>
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource BrushAccent}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="ContentSite"
                                              Margin="{TemplateBinding Padding}"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              VerticalAlignment="Center" HorizontalAlignment="Left"
                                              IsHitTestVisible="False"/>
                            <Popup x:Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Grid x:Name="DropDown"
                                      SnapsToDevicePixels="True"
                                      MinWidth="{TemplateBinding ActualWidth}"
                                      MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border x:Name="DropDownBorder"
                                            Background="{StaticResource BrushCard}"
                                            BorderBrush="{StaticResource BrushAccentDim}"
                                            BorderThickness="1"
                                            CornerRadius="4">
                                        <ScrollViewer SnapsToDevicePixels="True">
                                            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource BrushText}"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderThickness="0"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource BrushCardHi}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource BrushAccentDim}"/>
                                <Setter Property="TextElement.Foreground" Value="#FFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 按钮：基础（中性操作） -->
        <Style x:Key="BtnBase" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource BrushCardHi}"/>
            <Setter Property="Foreground" Value="{StaticResource BrushText}"/>
            <Setter Property="BorderBrush" Value="#3D4A40"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#45524A"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#5A6B5E"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#364039"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 按钮：主操作（金色，醒目） -->
        <Style x:Key="BtnPrimary" TargetType="Button" BasedOn="{StaticResource BtnBase}">
            <Setter Property="Background" Value="#C77F25"/>
            <Setter Property="Foreground" Value="#FFF5E2"/>
            <Setter Property="BorderBrush" Value="#E89B3C"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="46"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E89B3C"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#A8681D"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 按钮：危险（认输） -->
        <Style x:Key="BtnDanger" TargetType="Button" BasedOn="{StaticResource BtnBase}">
            <Setter Property="Background" Value="#8B3A2F"/>
            <Setter Property="Foreground" Value="#FFE4DE"/>
            <Setter Property="BorderBrush" Value="#D8584A"/>
        </Style>

        <!-- 分组卡标题 -->
        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource BrushTextDim}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <!-- 标签 -->
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource BrushTextDim}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource BrushBg}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="56"/>         <!-- 顶栏 -->
                <RowDefinition Height="*"/>          <!-- 主区 -->
                <RowDefinition Height="116"/>       <!-- 底栏 -->
            </Grid.RowDefinitions>

            <!-- ========== 顶栏 ========== -->
            <Border Grid.Row="0" Background="{StaticResource BrushPanel}" BorderBrush="{StaticResource BrushDivider}" BorderThickness="0,0,0,1">
                <DockPanel LastChildFill="False" Margin="20,0">
                    <!-- 左：应用名 -->
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="32" Height="32" CornerRadius="8" Background="#34513F" VerticalAlignment="Center">
                            <TextBlock Text="●" Foreground="{StaticResource BrushAccent}" FontSize="20"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-4,0,0"/>
                        </Border>
                        <TextBlock Text="{DynamicResource AppTitle}" Foreground="{StaticResource BrushText}" FontSize="18"
                                   FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,0"/>
                    </StackPanel>

                    <!-- 右：v1.0.7 只保留反馈按钮，其他全部去掉（云同步/开发者后台/联机/关于） -->
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="TopFeedbackBtn" Style="{StaticResource BtnBase}"
                                Content="{DynamicResource TopFeedback}" Height="34" Padding="10,0" FontSize="12" Margin="0,0,8,0"
                                ToolTip="{DynamicResource TopFeedbackTip}" Click="Feedback_Click"/>
                        <Button x:Name="TopAboutBtn" Style="{StaticResource BtnBase}"
                                Content="{DynamicResource TopAbout}" Height="34" Padding="10,0" FontSize="12" Margin="0,0,8,0"
                                ToolTip="{DynamicResource TopAboutTip}" Click="About_Click"/>
                        <Button x:Name="LangBtn" Style="{StaticResource BtnBase}"
                                Content="{DynamicResource LangToggle}" Height="34" Padding="10,0" FontSize="12" Margin="0,0,14,0"
                                ToolTip="{DynamicResource LangToggleTip}" Click="LangBtn_Click">
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="English" Click="LangMenu_Click"/>
                                    <MenuItem Header="中文" Click="LangMenu_Click"/>
                                    <MenuItem Header="日本語" Click="LangMenu_Click"/>
                                    <MenuItem Header="한국어" Click="LangMenu_Click"/>
                                    <MenuItem Header="Español" Click="LangMenu_Click"/>
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                    </StackPanel>

                    <!-- 右：当前对局状态（贴中间） -->
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="{StaticResource BrushCard}" Padding="10,5" CornerRadius="4" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" Fill="{StaticResource BrushAccent}" Margin="0,0,6,0"/>
                                <TextBlock x:Name="EngineDotText" Text="{DynamicResource EngineStarting}" Foreground="{StaticResource BrushText}" FontSize="12"/>
                            </StackPanel>
                        </Border>
                        <Border Background="{StaticResource BrushCard}" Padding="10,5" CornerRadius="4" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{DynamicResource StatusMovePre}" Foreground="{StaticResource BrushTextDim}" FontSize="12"/>
                                <TextBlock x:Name="MoveNumText" Text="0" Foreground="{StaticResource BrushAccent}" FontSize="13" FontWeight="Bold"/>
                                <TextBlock Text="{DynamicResource StatusMovePost}" Foreground="{StaticResource BrushTextDim}" FontSize="12"/>
                            </StackPanel>
                        </Border>
                        <Border Background="{StaticResource BrushCard}" Padding="10,5" CornerRadius="4" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{DynamicResource StatusColor}" Foreground="{StaticResource BrushTextDim}" FontSize="12"/>
                                <TextBlock x:Name="PlayerColorText" Text="—" Foreground="{StaticResource BrushText}" FontSize="12" FontWeight="SemiBold" Margin="4,0,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- ========== 主区：左侧棋盘 + 右侧设置栏 ========== -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="300"/>
                </Grid.ColumnDefinitions>

                <!-- 棋盘 -->
                <Border Grid.Column="0" Margin="16,16,8,8" Background="{StaticResource BrushPanel}" CornerRadius="10">
                    <Grid>
                        <!-- 上下分区：状态条永远在第一行，棋盘在中间，计时条紧贴棋盘下方，三者绝不重叠 -->
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>   <!-- 状态横条 -->
                            <RowDefinition Height="*"/>      <!-- 棋盘 + 回放条 -->
                            <RowDefinition Height="Auto"/>   <!-- 计时横条（永远可见，无需滚动） -->
                        </Grid.RowDefinitions>

                        <!-- 状态横条（第一行）
                                 🛠 v1.2.5 抖动根治：这是棋盘抖动的真正原因。
                                 原来 StackPanel 里 4 个 TextBlock 高度都随内容变化：
                                   - HintText 用 Collapsed↔Visible 切换 → 点「提示」时整条高度突增
                                   - 提示文本长度不同（"建议下 C5" vs "建议下 C5（胜率 7.6%）"）→ 换行数 1↔2 反复跳
                                   - WinrateText 从空变有内容 → 又增一行
                                 状态条是 Height="Auto"，高度一变就把下面的棋盘挤压/拉伸 → 肉眼抖动。
                                 修法：每个 TextBlock 固定 Height（内容变化不再影响布局），
                                 HintText 改用 Hidden 而非 Collapsed（保留占位高度）。 -->
                            <Border Grid.Row="0" Background="{StaticResource BrushCard}" CornerRadius="6" Padding="14,10" Margin="16,16,16,8">
                                <StackPanel>
                                    <TextBlock x:Name="StatusText" Text="{DynamicResource IdleStatus}"
                                               Foreground="{StaticResource BrushAccent}" FontSize="14" FontWeight="SemiBold"
                                               Height="20" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock x:Name="StatusHintText" Text="{DynamicResource IdleHint}"
                                               Foreground="{StaticResource BrushTextDim}" FontSize="11" Margin="0,4,0,0"
                                               Height="16" TextTrimming="CharacterEllipsis"/>
                                    <!-- 实时胜率（KataGo kata-genmove_analyze 输出，玩家视角换算） -->
                                    <TextBlock x:Name="WinrateText" Text=""
                                               Foreground="{StaticResource BrushHuman}" FontSize="13" FontWeight="SemiBold"
                                               Margin="0,8,0,0" Height="18" TextTrimming="CharacterEllipsis"
                                               ToolTip="KataGo live position evaluation: win rate + score lead computed by kata-genmove_analyze after each AI move"/>
                                    <!-- AI 提示结果（点「💡 提示」后显示，落子/新局/悔棋时自动隐藏）
                                         ⚠ 必须用 Hidden 而非 Collapsed：Hidden 保留占位高度，
                                         切到 Visible 时状态条总高度不变，棋盘不会被挤压。 -->
                                    <TextBlock x:Name="HintText" Text=""
                                               Foreground="#7CF2C0" FontSize="12" FontWeight="SemiBold"
                                               Margin="0,6,0,0" Height="36" TextWrapping="Wrap"
                                               TextTrimming="CharacterEllipsis" Visibility="Hidden"/>
                                </StackPanel>
                            </Border>

                        <!-- 棋盘与回放条（第二行：棋盘居中、回放条贴底，绝对不会盖到状态条） -->
                        <Grid Grid.Row="1">
                            <local:BoardControl x:Name="BoardView" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="8,4,8,8"/>
                        </Grid>

                        <!-- 计时横条（第三行，紧贴棋盘下方，永远可见） -->
                        <Border Grid.Row="2" Background="{StaticResource BrushCard}" CornerRadius="6" Padding="16,10" Margin="16,8,16,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- 玩家时间 -->
                                <Grid Grid.Column="0" Margin="0,0,12,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid Grid.Row="0" Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{DynamicResource YourTime}" Foreground="{StaticResource BrushHuman}" FontSize="12" FontWeight="SemiBold"/>
                                        <TextBlock Grid.Column="1" x:Name="HumanTimerText" Text="—"
                                                   Foreground="{StaticResource BrushText}" FontSize="14" FontWeight="Bold"/>
                                    </Grid>
                                    <ProgressBar Grid.Row="1" x:Name="HumanTimerBar" Height="8" Background="#1A201C"
                                                 Foreground="{StaticResource BrushHuman}" Minimum="0" Maximum="100" Value="100">
                                        <ProgressBar.BorderThickness>0</ProgressBar.BorderThickness>
                                    </ProgressBar>
                                </Grid>

                                <!-- AI 思考 -->
                                <Grid Grid.Column="1" Margin="12,0,0,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid Grid.Row="0" Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{DynamicResource AiThinking}" Foreground="{StaticResource BrushAI}" FontSize="12" FontWeight="SemiBold"/>
                                        <TextBlock Grid.Column="1" x:Name="AiTimerText" Text="{DynamicResource Standby}"
                                                   Foreground="{StaticResource BrushText}" FontSize="14" FontWeight="Bold"/>
                                    </Grid>
                                    <ProgressBar Grid.Row="1" x:Name="AiTimerBar" Height="8" Background="#1A201C"
                                                 Foreground="{StaticResource BrushAI}" Minimum="0" Maximum="100" Value="0">
                                        <ProgressBar.BorderThickness>0</ProgressBar.BorderThickness>
                                    </ProgressBar>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <!-- 右侧栏：设置 + 操作 -->
                <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Margin="8,16,16,8">
                    <StackPanel>

                        <!-- 卡 1：对局设置 -->
                        <Border Background="{StaticResource BrushPanel}" CornerRadius="10" Padding="16">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource SettingsTitle}" Style="{StaticResource CardTitle}"/>
                                <TextBlock Text="{DynamicResource LabelDifficulty}" Style="{StaticResource Label}"/>
                                <ComboBox x:Name="LevelBox" SelectedIndex="1" SelectionChanged="LevelBox_Changed">
                                    <ComboBoxItem Content="{DynamicResource LevelBeginner}"/>
                                    <ComboBoxItem Content="{DynamicResource LevelEasy}"/>
                                    <ComboBoxItem Content="{DynamicResource LevelMedium}"/>
                                    <ComboBoxItem Content="{DynamicResource LevelHard}"/>
                                </ComboBox>

                                <TextBlock Text="{DynamicResource LabelBoardSize}" Style="{StaticResource Label}" Margin="0,14,0,6"/>
                                <ComboBox x:Name="SizeBox" SelectedIndex="2" SelectionChanged="SizeBox_Changed">
                                    <ComboBoxItem Content="{DynamicResource Size9}"/>
                                    <ComboBoxItem Content="{DynamicResource Size13}"/>
                                    <ComboBoxItem Content="{DynamicResource Size19}"/>
                                </ComboBox>

                                <TextBlock Text="{DynamicResource LabelYourColor}" Style="{StaticResource Label}" Margin="0,14,0,6"/>
                                <ComboBox x:Name="ColorBox" SelectedIndex="0">
                                    <ComboBoxItem Content="{DynamicResource ColorBlackOpt}"/>
                                    <ComboBoxItem Content="{DynamicResource ColorWhiteOpt}"/>
                                </ComboBox>

                                <TextBlock x:Name="SizeHintText" Text="{DynamicResource SizeHint}"
                                           Foreground="{StaticResource BrushTextMute}" FontSize="11" Margin="0,10,0,0"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- 卡 2：对局操作 -->
                        <Border Background="{StaticResource BrushPanel}" CornerRadius="10" Padding="16" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource OpsTitle}" Style="{StaticResource CardTitle}"/>

                                <Button x:Name="NewGameBtn" Style="{StaticResource BtnPrimary}"
                                        Content="{DynamicResource NewGame}" Margin="0,0,0,8" Click="NewGame_Click"/>

                                <Button x:Name="HintBtn" Style="{StaticResource BtnBase}"
                                        Content="{DynamicResource Hint}" Margin="0,0,0,8" Click="Hint_Click"
                                        ToolTip="{DynamicResource HintTip}"/>

                                <Button Style="{StaticResource BtnBase}" x:Name="UndoBtn"
                                        Content="{DynamicResource Undo}" Margin="0,0,0,6" Click="Undo_Click"/>

                                <Button Style="{StaticResource BtnBase}" x:Name="PassBtn"
                                        Content="{DynamicResource Pass}" Margin="0,0,0,6" Click="Pass_Click"/>

                                <Button Style="{StaticResource BtnBase}" x:Name="ScoreBtn"
                                        Content="{DynamicResource Score}" Margin="0,0,0,6" Click="Score_Click"/>

                                <Button Style="{StaticResource BtnBase}" x:Name="SaveBtn"
                                        Content="{DynamicResource Save}" Margin="0,0,0,6" Click="Save_Click"/>

                                <Button x:Name="ResignBtn" Style="{StaticResource BtnDanger}"
                                        Content="{DynamicResource Resign}" Margin="0,0,0,0"
                                        Click="Resign_Click"/>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- ========== 底栏：局面信息 ========== -->
            <Border Grid.Row="2" Background="{StaticResource BrushPanel}" BorderBrush="{StaticResource BrushDivider}" BorderThickness="0,1,0,0">
                <!-- 右边距 16：与右侧栏 ScrollViewer 的右 Margin 一致，
                     使底栏最右元素（终局数子）与右栏右边缘严格平齐 -->
                <Grid Margin="20,12,16,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180"/>    <!-- 黑方信息卡（最左） -->
                        <ColumnDefinition Width="*"/>      <!-- 局面信息（手数/执子/提示） -->
                        <ColumnDefinition Width="180"/>    <!-- 白方信息卡：右边缘贴齐右栏左边缘 -->
                        <ColumnDefinition Width="144"/>    <!-- 间距：144 = 右栏宽300 - 按钮列130 - 白卡右margin10 - 底栏右margin16 -->
                        <ColumnDefinition Width="130"/>    <!-- 终局数子按钮（固定列宽，右边缘对齐右栏右边缘） -->
                    </Grid.ColumnDefinitions>

                    <!-- 黑方信息卡 -->
                    <Border Grid.Column="0" Background="{StaticResource BrushCard}" CornerRadius="8" Padding="14,8" Margin="0,0,10,0" VerticalAlignment="Center">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Ellipse Grid.Column="0" Width="22" Height="22" Fill="#1A1A1A" Stroke="#444" StrokeThickness="1" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource BlackLabel}" Foreground="{StaticResource BrushText}" FontSize="14" FontWeight="SemiBold"/>
                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                    <TextBlock Text="{DynamicResource StonesLabel} " Foreground="{StaticResource BrushTextDim}" FontSize="11"/>
                                    <TextBlock x:Name="BlackCountText" Text="0" Foreground="{StaticResource BrushText}" FontSize="13" FontWeight="Bold"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                    <TextBlock Text="{DynamicResource LastLabel} " Foreground="{StaticResource BrushTextDim}" FontSize="11"/>
                                    <TextBlock x:Name="BlackLastMoveText" Text="—" Foreground="{StaticResource BrushAccent}" FontSize="13" FontWeight="SemiBold"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 中间局面信息 -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="{DynamicResource MovePre}" Foreground="{StaticResource BrushTextDim}" FontSize="12"/>
                            <TextBlock x:Name="BottomMoveNumText" Text="0" Foreground="{StaticResource BrushAccent}" FontSize="14" FontWeight="Bold"/>
                            <TextBlock Text="{DynamicResource MovePost}" Foreground="{StaticResource BrushTextDim}" FontSize="12"/>
                            <Border Width="1" Background="{StaticResource BrushDivider}" Margin="14,0"/>
                            <TextBlock Text="{DynamicResource TurnLabel}" Foreground="{StaticResource BrushTextDim}" FontSize="12"/>
                            <TextBlock x:Name="BottomTurnText" Text="—" Foreground="{StaticResource BrushText}" FontSize="13" FontWeight="SemiBold"/>
                        </StackPanel>
                        <!-- 🛠 v1.2.5：同上，改用 Hidden 保留占位高度 + 固定 Height，
                                 避免终局提示出现/消失时底栏高度变化挤压棋盘。 -->
                        <TextBlock x:Name="EndgameHintText" Text="" Foreground="{StaticResource BrushDanger}" FontSize="12" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" Margin="0,6,0,0" Height="16" Visibility="Hidden"/>
                    </StackPanel>

                    <!-- 白方信息卡（位于终局数子按钮左侧） -->
                    <Border Grid.Column="2" Background="{StaticResource BrushCard}" CornerRadius="8" Padding="14,8" Margin="10,0,10,0" VerticalAlignment="Center">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Right">
                                <TextBlock Text="{DynamicResource WhiteLabel}" Foreground="{StaticResource BrushText}" FontSize="14" FontWeight="SemiBold" TextAlignment="Right"/>
                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0" HorizontalAlignment="Right">
                                    <TextBlock Text="{DynamicResource StonesLabel} " Foreground="{StaticResource BrushTextDim}" FontSize="11"/>
                                    <TextBlock x:Name="WhiteCountText" Text="0" Foreground="{StaticResource BrushText}" FontSize="13" FontWeight="Bold"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0" HorizontalAlignment="Right">
                                    <TextBlock Text="{DynamicResource LastLabel} " Foreground="{StaticResource BrushTextDim}" FontSize="11"/>
                                    <TextBlock x:Name="WhiteLastMoveText" Text="—" Foreground="{StaticResource BrushAccent}" FontSize="13" FontWeight="SemiBold"/>
                                </StackPanel>
                            </StackPanel>
                            <Ellipse Grid.Column="1" Width="22" Height="22" Fill="#F5F5F0" Stroke="#888" StrokeThickness="1" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- 终局数子按钮：右边缘与右栏右边缘平齐（与白棋卡之间留 164+10 间距） -->
                    <Button Grid.Column="4" Style="{StaticResource BtnPrimary}" x:Name="EndgameBtn"
                            Content="{DynamicResource Score}" Height="48" FontSize="14"
                            HorizontalAlignment="Stretch" VerticalAlignment="Center" Click="Score_Click"/>
                </Grid>
            </Border>

            <!-- ========== 终局胜负覆盖层（默认隐藏） ========== -->
            <Grid Grid.Row="0" Grid.RowSpan="3" x:Name="EndgameOverlay" Visibility="Collapsed" Background="#CC000000">
                <Border Background="{StaticResource BrushPanel}" CornerRadius="16" Padding="40,32"
                        HorizontalAlignment="Center" VerticalAlignment="Center" MinWidth="540" MaxWidth="700"
                        BorderBrush="{StaticResource BrushAccent}" BorderThickness="2">
                    <Grid>
                        <!-- 右上角 X 关闭按钮（半透明，hover 变亮） -->
                        <Button x:Name="EndgameCornerCloseBtn"
                                HorizontalAlignment="Right" VerticalAlignment="Top"
                                Margin="0,-14,-14,0" Padding="10,4"
                                Background="Transparent"
                                Foreground="{StaticResource BrushTextDim}"
                                BorderThickness="0"
                                Content="✕" FontSize="18" Cursor="Hand"
                                ToolTip="Close panel (ESC)"
                                Click="EndgameClose_Click"
                                IsCancel="True"/>

                        <!-- 主体内容（与右上角按钮不冲突） -->
                        <StackPanel HorizontalAlignment="Center">
                        <TextBlock x:Name="EndgameTitle" Text="{DynamicResource EndgameTitle}"
                                   Foreground="{StaticResource BrushAccent}" FontSize="26" FontWeight="Bold"
                                   HorizontalAlignment="Center" Margin="0,0,0,12"/>
                        <TextBlock x:Name="EndgameWinner" Text="Black"
                                   Foreground="{StaticResource BrushText}" FontSize="40" FontWeight="Bold"
                                   HorizontalAlignment="Center"/>
                        <TextBlock x:Name="EndgameScore" Text="Win by X.X"
                                   Foreground="{StaticResource BrushAccent}" FontSize="20" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" Margin="0,6,0,0"/>

                        <!-- 详细算账卡：黑/白/差/含贴目 -->
                        <Border Background="{StaticResource BrushCard}" CornerRadius="10" Padding="20,14" Margin="0,18,0,0">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{DynamicResource EndgameDetailBlackYou}" Foreground="{StaticResource BrushText}" FontSize="12" HorizontalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="Black" Foreground="{StaticResource BrushText}" FontSize="12" HorizontalAlignment="Center" Visibility="Collapsed"/>
                                    <TextBlock Grid.Column="1" Text="{DynamicResource EndgameStones}" Foreground="{StaticResource BrushTextDim}" FontSize="11" HorizontalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="{DynamicResource EndgameTerritory}" Foreground="{StaticResource BrushTextDim}" FontSize="11" HorizontalAlignment="Center"/>
                                    <TextBlock Grid.Column="3" Text="{DynamicResource EndgameDetailWhiteAi}" Foreground="{StaticResource BrushText}" FontSize="12" HorizontalAlignment="Center"/>
                                </Grid>
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" x:Name="EndgameBlackTotal" Text="—" Foreground="{StaticResource BrushText}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" x:Name="EndgameBlackStones" Text="—" Foreground="{StaticResource BrushText}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" x:Name="EndgameBlackEmpty" Text="—" Foreground="{StaticResource BrushText}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
                                    <TextBlock Grid.Column="3" x:Name="EndgameWhiteTotal" Text="—" Foreground="{StaticResource BrushText}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="" FontSize="11"/>
                                    <TextBlock Grid.Column="1" x:Name="EndgameWhiteStones" Text="—" Foreground="{StaticResource BrushText}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" x:Name="EndgameWhiteEmpty" Text="—" Foreground="{StaticResource BrushText}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
                                    <TextBlock Grid.Column="3" Text="" FontSize="11"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 贴目+公式提示 -->
                        <Border Background="#2A1E1A" CornerRadius="8" Padding="14,10" Margin="0,10,0,0" BorderBrush="#5A3A28" BorderThickness="1">
                            <StackPanel>
                                <TextBlock x:Name="EndgameFormula" Text=""
                                           Foreground="#D4A574" FontSize="12" LineHeight="20"
                                           HorizontalAlignment="Center"/>
                                <TextBlock x:Name="EndgameKomiNote" Text=""
                                           Foreground="{StaticResource BrushTextDim}" FontSize="11"
                                           HorizontalAlignment="Center" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                            <Button Style="{StaticResource BtnPrimary}" x:Name="EndgameNewGameBtn"
                                    Content="{DynamicResource EndgameNewGame}" Height="44" Padding="20,0" FontSize="14" Margin="0,0,10,0"
                                    Click="NewGame_Click"/>
                            <Button Style="{StaticResource BtnBase}" x:Name="EndgameReviewBtn"
                                    Content="{DynamicResource EndgameReview}" Height="44" Padding="20,0" FontSize="14" Margin="0,0,10,0"
                                    ToolTip="View the win-rate curve and turning points after each KataGo move"
                                    Click="EndgameReview_Click"/>
                            <Button Style="{StaticResource BtnBase}" x:Name="EndgameCloseBtn"
                                    Content="{DynamicResource EndgameClose}" Height="44" Padding="20,0" FontSize="14"
                                    ToolTip="Close the popup only — view the board without starting a new game"
                                    Click="EndgameClose_Click"/>
                        </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
