<Window x:Class="GoGame.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="中国围棋 · 登录" Height="540" Width="460"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        Background="#1E2620" FontFamily="Segoe UI, Microsoft YaHei UI">
    <Window.Resources>
        <!-- 配色沿用主界面：墨绿底 + 琥珀金强调 -->
        <SolidColorBrush x:Key="BrushBg"        Color="#1E2620"/>
        <SolidColorBrush x:Key="BrushCard"      Color="#2D3A32"/>
        <SolidColorBrush x:Key="BrushCardHi"    Color="#354539"/>
        <SolidColorBrush x:Key="BrushText"      Color="#F0F2EE"/>
        <SolidColorBrush x:Key="BrushTextDim"   Color="#9CA89F"/>
        <SolidColorBrush x:Key="BrushTextMute"  Color="#6F7B73"/>
        <SolidColorBrush x:Key="BrushAccent"    Color="#E89B3C"/>
        <SolidColorBrush x:Key="BrushDanger"    Color="#D8584A"/>

        <!-- 输入框：TextBox 与 PasswordBox 共用一套外观 -->
        <Style x:Key="InputBase" TargetType="Control">
            <Setter Property="Background" Value="{StaticResource BrushCard}"/>
            <Setter Property="Foreground" Value="{StaticResource BrushText}"/>
            <Setter Property="BorderBrush" Value="#3D4A40"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="TextBox" BasedOn="{StaticResource InputBase}">
            <Setter Property="CaretBrush" Value="{StaticResource BrushText}"/>
        </Style>
        <Style TargetType="PasswordBox" BasedOn="{StaticResource InputBase}">
            <Setter Property="CaretBrush" Value="{StaticResource BrushText}"/>
        </Style>

        <!-- 复选框：自绘模板，保证深底上也看得清，勾选为金色 -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource BrushTextDim}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="box" Width="16" Height="16" CornerRadius="3"
                                    Background="{StaticResource BrushCard}"
                                    BorderBrush="#4A5A50" BorderThickness="1"
                                    VerticalAlignment="Center">
                                <Path x:Name="check" Data="M 3 6.5 L 6 9.5 L 11.5 3.5"
                                      Stroke="{StaticResource BrushAccent}" StrokeThickness="2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Visibility="Collapsed"/>
                            </Border>
                            <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="check" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="box" Property="BorderBrush"
                                        Value="{StaticResource BrushAccent}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="box" Property="BorderBrush"
                                        Value="{StaticResource BrushAccent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 登录 / 注册 切换页签 -->
        <Style x:Key="TabBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource BrushTextMute}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="#C8D2CB"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 主操作按钮（金色，文字居中） -->
        <Style x:Key="BtnMain" TargetType="Button">
            <Setter Property="Background" Value="#C77F25"/>
            <Setter Property="Foreground" Value="#FFF5E2"/>
            <Setter Property="BorderBrush" Value="{StaticResource BrushAccent}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="46"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#E89B3C"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#A8681D"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 次级按钮（随机用户名） -->
        <Style x:Key="BtnSub" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource BrushCardHi}"/>
            <Setter Property="Foreground" Value="#C8D2CB"/>
            <Setter Property="BorderBrush" Value="#3D4A40"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#45524A"/>
                                <Setter TargetName="bd" Property="BorderBrush"
                                        Value="{StaticResource BrushAccent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource BrushTextDim}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- 标题 -->
            <RowDefinition Height="40"/>     <!-- 页签 -->
            <RowDefinition Height="*"/>      <!-- 面板 -->
            <RowDefinition Height="Auto"/>   <!-- 底部说明 -->
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <StackPanel Grid.Row="0" Margin="0,32,0,24" HorizontalAlignment="Center">
            <TextBlock Text="中国围棋" FontSize="27" FontWeight="SemiBold"
                       Foreground="{StaticResource BrushAccent}"
                       HorizontalAlignment="Center"/>
            <TextBlock Text="AI 对弈 · 复盘 · 死活题" FontSize="12"
                       Foreground="{StaticResource BrushTextMute}"
                       HorizontalAlignment="Center" Margin="0,8,0,0"/>
        </StackPanel>

        <!-- 页签 -->
        <Grid Grid.Row="1" Margin="38,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" x:Name="TabLoginBtn" Content="登录"
                    Style="{StaticResource TabBtn}" Click="TabLogin_Click"/>
            <Border Grid.Column="0" x:Name="TabLoginLine" Height="2"
                    VerticalAlignment="Bottom" Background="{StaticResource BrushAccent}"/>
            <Button Grid.Column="1" x:Name="TabRegisterBtn" Content="注册"
                    Style="{StaticResource TabBtn}" Click="TabRegister_Click"/>
            <Border Grid.Column="1" x:Name="TabRegisterLine" Height="2"
                    VerticalAlignment="Bottom" Background="{StaticResource BrushAccent}"
                    Visibility="Collapsed"/>
        </Grid>

        <!-- 登录面板 -->
        <StackPanel x:Name="LoginPanel" Grid.Row="2" Margin="38,24,38,0">
            <TextBlock Text="用户名" Style="{StaticResource Label}"/>
            <TextBox x:Name="LoginNameBox" Margin="0,0,0,16"/>

            <TextBlock Text="密码" Style="{StaticResource Label}"/>
            <PasswordBox x:Name="LoginPwdBox" Margin="0,0,0,14"/>

            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <CheckBox x:Name="RememberNameCheck" Grid.Column="0" Content="记住用户名"/>
                <CheckBox x:Name="RememberPwdCheck" Grid.Column="1" Content="记住密码"/>
            </Grid>

            <Button x:Name="LoginBtn" Content="登 录" Style="{StaticResource BtnMain}"
                    Click="Login_Click"/>

            <TextBlock x:Name="LoginHint" FontSize="12" Margin="0,14,0,0"
                       TextWrapping="Wrap" Visibility="Collapsed"
                       Foreground="{StaticResource BrushDanger}"/>
        </StackPanel>

        <!-- 注册面板 -->
        <StackPanel x:Name="RegisterPanel" Grid.Row="2" Margin="38,24,38,0"
                    Visibility="Collapsed">
            <TextBlock Text="用户名" Style="{StaticResource Label}"/>
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="RegNameBox" Grid.Column="0"/>
                <Button x:Name="RandomNameBtn" Grid.Column="1" Content="随机"
                        Style="{StaticResource BtnSub}" Width="66" Margin="8,0,0,0"
                        Click="RandomName_Click"/>
            </Grid>

            <TextBlock Text="密码（至少 6 位）" Style="{StaticResource Label}"/>
            <PasswordBox x:Name="RegPwdBox" Margin="0,0,0,16"/>

            <TextBlock Text="确认密码" Style="{StaticResource Label}"/>
            <PasswordBox x:Name="RegPwd2Box" Margin="0,0,0,20"/>

            <Button x:Name="RegisterBtn" Content="注 册 并 进 入"
                    Style="{StaticResource BtnMain}" Click="Register_Click"/>

            <TextBlock x:Name="RegHint" FontSize="12" Margin="0,14,0,0"
                       TextWrapping="Wrap" Visibility="Collapsed"
                       Foreground="{StaticResource BrushDanger}"/>
        </StackPanel>

        <!-- 底部说明 -->
        <TextBlock Grid.Row="3" Text="账号数据保存在本机 · 每天需重新登录一次"
                   Foreground="{StaticResource BrushTextMute}" FontSize="11"
                   HorizontalAlignment="Center" Margin="0,0,0,22"/>
    </Grid>
</Window>
