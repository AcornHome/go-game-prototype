<Window x:Class="GoGame.MailConfigDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="配置反馈邮箱" Height="620" Width="640"
        WindowStartupLocation="CenterOwner"
        Background="#F8F4EA"
        FontFamily="Microsoft YaHei UI"
        TextOptions.TextFormattingMode="Display"
        WindowStyle="SingleBorderWindow">

    <Window.Resources>
        <Style TargetType="TextBox" x:Key="Input">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D9D2C0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="Button" x:Key="PrimaryBtn">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="6" Padding="22,10" Background="#C8964F">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#B07F38"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#C8BFA8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button" x:Key="GhostBtn">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#666"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="6" Padding="22,10" Background="Transparent"
                                BorderBrush="#D9D2C0" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F0EBDC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="📮 配置反馈邮箱" FontSize="22" FontWeight="SemiBold" Foreground="#2B2014"/>
            <TextBlock Text="把反馈直接发到开发者邮箱（QQ 邮箱 SMTP）" FontSize="13" Foreground="#8F6427" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- 说明步骤 -->
        <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="20,18" BorderBrush="#E0DAC6" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="如何获取 QQ 邮箱「授权码」" FontSize="14" FontWeight="SemiBold" Foreground="#2B2014" Margin="0,0,0,10"/>

                <TextBlock Text="（授权码 ≠ QQ 密码，是 QQ 邮箱专用的 16 位 SMTP 凭据）" FontSize="11" Foreground="#999" Margin="0,0,0,12"/>

                <StackPanel>
                    <TextBlock FontSize="13" Foreground="#444" Margin="0,0,0,6">
                        <Run Text="① "/><Run Text="电脑浏览器打开" FontWeight="SemiBold"/><Run Text=" mail.qq.com 登录你的 QQ 邮箱"/>
                    </TextBlock>
                    <TextBlock FontSize="13" Foreground="#444" Margin="0,0,0,6">
                        <Run Text="② "/><Run Text="顶部「设置」" FontWeight="SemiBold"/><Run Text=" → 「账户」标签"/>
                    </TextBlock>
                    <TextBlock FontSize="13" Foreground="#444" Margin="0,0,0,6">
                        <Run Text="③ "/><Run Text="往下翻到「POP3/IMAP/SMTP/Exchange/CardDAV/CalDAV服务」" FontWeight="SemiBold"/>
                    </TextBlock>
                    <TextBlock FontSize="13" Foreground="#444" Margin="0,0,0,6">
                        <Run Text="④ "/><Run Text="开启「SMTP服务」" FontWeight="SemiBold"/><Run Text="（可能需要短信验证）"/>
                    </TextBlock>
                    <TextBlock FontSize="13" Foreground="#444" Margin="0,0,0,16">
                        <Run Text="⑤ "/><Run Text="点「生成授权码」" FontWeight="SemiBold"/><Run Text="，按提示发短信后拿到 16 位字符"/>
                    </TextBlock>
                </StackPanel>

                <TextBlock Text="把得到的授权码粘到下面：" FontSize="13" Foreground="#666" Margin="0,0,0,8"/>

                <PasswordBox x:Name="AuthBox" FontSize="14" Padding="10,8" Height="38"
                             Background="White" BorderBrush="#D9D2C0" BorderThickness="1"
                             PasswordChar="●"/>

                <TextBlock x:Name="HintText" Text="" FontSize="12" Foreground="#666" Margin="0,10,0,0" TextWrapping="Wrap"/>

                <CheckBox x:Name="ShowPwdCheck" Content="显示明文" Margin="0,10,0,0"
                          Foreground="#666" FontSize="12" Cursor="Hand"
                          Checked="ShowPwd_Checked" Unchecked="ShowPwd_Unchecked"/>
            </StackPanel>
        </Border>

        <!-- 底部按钮 -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="取消" Style="{StaticResource GhostBtn}" Margin="0,0,8,0" Click="Cancel_Click"/>
            <Button x:Name="TestBtn" Content="🔌 保存并测试" Style="{StaticResource PrimaryBtn}" Click="Test_Click"/>
        </StackPanel>
    </Grid>
</Window>