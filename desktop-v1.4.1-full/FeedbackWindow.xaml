<Window x:Class="GoGame.FeedbackWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="问题反馈 · 中国围棋" Height="700" Width="820"
        WindowStartupLocation="CenterOwner"
        Background="#F8F4EA"
        FontFamily="Microsoft YaHei UI"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        WindowStyle="SingleBorderWindow">

    <!-- ============== 资源样式 ============== -->
    <Window.Resources>
        <!-- 单行输入框 -->
        <Style TargetType="TextBox" x:Key="Input">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D9D2C0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="AcceptsReturn" Value="False"/>
            <Setter Property="TextWrapping" Value="NoWrap"/>
        </Style>

        <!-- 多行输入框 -->
        <Style TargetType="TextBox" x:Key="MultiLineInput" BasedOn="{StaticResource Input}">
            <Setter Property="VerticalContentAlignment" Value="Top"/>
            <Setter Property="AcceptsReturn" Value="True"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="MinHeight" Value="180"/>
            <Setter Property="MaxHeight" Value="320"/>
        </Style>

        <!-- 分类卡片（RadioButton 自定义模板） -->
        <Style TargetType="RadioButton" x:Key="CategoryCard">
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#333"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="White"
                                BorderBrush="#E0DAC6" BorderThickness="1"
                                CornerRadius="6" Padding="14,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="IconTxt" Grid.Column="0" Text="{TemplateBinding Tag}"
                                           FontSize="20" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <ContentPresenter Grid.Column="1" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FBF6E8"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#C8B47A"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FBF0D4"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#C8964F"/>
                                <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 主按钮（提交） -->
        <Style TargetType="Button" x:Key="PrimaryBtn">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="6" Padding="28,10" Background="#C8964F">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#B07F38"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#8F6427"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#C8BFA8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 次按钮（取消） -->
        <Style TargetType="Button" x:Key="GhostBtn">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#666"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="6" Padding="22,10" Background="Transparent"
                                BorderBrush="#D9D2C0" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F0EBDC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Padding="0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>  <!-- 顶部 banner -->
                <RowDefinition Height="*"/>     <!-- 主体 -->
                <RowDefinition Height="Auto"/>  <!-- 底部按钮 -->
            </Grid.RowDefinitions>

            <!-- ============== 顶部 Banner（深木纹）============== -->
            <Border Grid.Row="0">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#2B2014" Offset="0"/>
                        <GradientStop Color="#4A331C" Offset="0.5"/>
                        <GradientStop Color="#2B2014" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Border Padding="32,22">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="●" FontSize="22" Foreground="#F5E6C8" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="○" FontSize="18" Foreground="#F5E6C8" VerticalAlignment="Center" Margin="0,0,14,0"/>
                            <TextBlock Text="问题反馈" FontSize="26" FontWeight="SemiBold" Foreground="#F5E6C8"/>
                            <TextBlock Text=" · 中国围棋" FontSize="14" Foreground="#DCC68B" VerticalAlignment="Bottom" Margin="4,0,0,5"/>
                        </StackPanel>
                        <TextBlock Text="发现什么问题？我们逐条查看，让程序越用越顺手。"
                                   FontSize="13" Foreground="#C8B47A" Margin="50,4,0,0"/>
                    </StackPanel>
                </Border>
            </Border>

            <!-- ============== 主体（左右两栏）============== -->
            <Grid Grid.Row="1" Margin="32,24,32,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="240"/>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 左：分类卡片 -->
                <StackPanel Grid.Column="0">
                    <TextBlock Text="问题类型" FontSize="13" Foreground="#666" Margin="2,0,0,10" FontWeight="SemiBold"/>
                    <RadioButton x:Name="CatKataGo" Style="{StaticResource CategoryCard}" Tag="🐢" GroupName="Cat" IsChecked="True">
                        <TextBlock Text="KataGo 异常" FontSize="14" FontWeight="SemiBold"/>
                        <RadioButton.ToolTip>
                            <TextBlock Text="不响应 / 报错 / 走子很慢"/>
                        </RadioButton.ToolTip>
                    </RadioButton>
                    <RadioButton x:Name="CatUi" Style="{StaticResource CategoryCard}" Tag="🖱️" GroupName="Cat">
                        <TextBlock Text="界面卡顿" FontSize="14" FontWeight="SemiBold"/>
                        <RadioButton.ToolTip>
                            <TextBlock Text="闪烁 / 鼠标失灵 / 按钮没反应"/>
                        </RadioButton.ToolTip>
                    </RadioButton>
                    <RadioButton x:Name="CatReview" Style="{StaticResource CategoryCard}" Tag="📜" GroupName="Cat">
                        <TextBlock Text="复盘 / SGF" FontSize="14" FontWeight="SemiBold"/>
                        <RadioButton.ToolTip>
                            <TextBlock Text="SGF 加载 / 报告生成 / 走子记录"/>
                        </RadioButton.ToolTip>
                    </RadioButton>
                    <RadioButton x:Name="CatLearn" Style="{StaticResource CategoryCard}" Tag="🧩" GroupName="Cat">
                        <TextBlock Text="教学功能" FontSize="14" FontWeight="SemiBold"/>
                        <RadioButton.ToolTip>
                            <TextBlock Text="死活题 / 联机 / 围棋教程"/>
                        </RadioButton.ToolTip>
                    </RadioButton>
                    <RadioButton x:Name="CatInstall" Style="{StaticResource CategoryCard}" Tag="📦" GroupName="Cat">
                        <TextBlock Text="安装与启动" FontSize="14" FontWeight="SemiBold"/>
                        <RadioButton.ToolTip>
                            <TextBlock Text="安装包 / .NET / 卸载"/>
                        </RadioButton.ToolTip>
                    </RadioButton>
                    <RadioButton x:Name="CatOther" Style="{StaticResource CategoryCard}" Tag="💭" GroupName="Cat">
                        <TextBlock Text="其他 / 建议" FontSize="14" FontWeight="SemiBold"/>
                        <RadioButton.ToolTip>
                            <TextBlock Text="功能建议 / 想法 / 用其他"/>
                        </RadioButton.ToolTip>
                    </RadioButton>
                </StackPanel>

                <!-- 右：表单 -->
                <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock FontSize="13" Foreground="#666" Margin="2,0,0,10" FontWeight="SemiBold">
                            <Run Text="一句话标题"/>
                            <Run Text=" *" Foreground="#C8964F"/>
                        </TextBlock>
                        <TextBox x:Name="TitleBox" Style="{StaticResource Input}" MaxLength="120"
                                 Tag="例：死活题模式 KataGo 一直报 timeout"/>
                        <TextBlock x:Name="TitleCount" Text="0 / 120" FontSize="11" Foreground="#999"
                                   HorizontalAlignment="Right" Margin="0,4,4,0"/>

                        <TextBlock FontSize="13" Foreground="#666" Margin="2,16,0,10" FontWeight="SemiBold">
                            <Run Text="详细描述"/>
                            <Run Text="（选填）" Foreground="#999" FontWeight="Normal"/>
                        </TextBlock>
                        <TextBox x:Name="DetailBox" Style="{StaticResource MultiLineInput}"
                                 Tag="怎么触发的？复现步骤？期望什么样？实际什么样？"/>

                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" FontSize="13" Foreground="#666" Margin="2,0,0,10" FontWeight="SemiBold">
                                <Run Text="邮箱"/>
                                <Run Text="（选填）" Foreground="#999" FontWeight="Normal"/>
                            </TextBlock>
                            <TextBlock Grid.Row="0" Grid.Column="2" FontSize="13" Foreground="#666" Margin="2,0,0,10" FontWeight="SemiBold">
                                <Run Text="Steam 主名"/>
                                <Run Text="（选填）" Foreground="#999" FontWeight="Normal"/>
                            </TextBlock>
                            <TextBox Grid.Row="1" Grid.Column="0" x:Name="EmailBox" Style="{StaticResource Input}"/>
                            <TextBox Grid.Row="1" Grid.Column="2" x:Name="SteamBox" Style="{StaticResource Input}"/>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- ============== 底部按钮 ============== -->
            <Border Grid.Row="2" Padding="32,8,32,22" Background="#F8F4EA">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock x:Name="HintText" Text="提交后通过 QQ 邮箱 SMTP 直接发送到开发者邮箱"
                               FontSize="11" Foreground="#999" VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <Button Content="取消" Style="{StaticResource GhostBtn}" Click="Cancel_Click" Margin="0,0,8,0"/>
                    <Button x:Name="SubmitBtn" Content="📤 提交反馈" Style="{StaticResource PrimaryBtn}" Click="Submit_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
