<Window x:Class="GoGame.SgfReplayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:GoGame"
        Title="打谱 / 复盘" Height="780" Width="920"
        WindowStartupLocation="CenterOwner"
        Background="#1E2620" FontFamily="Segoe UI, Microsoft YaHei UI"
        KeyDown="Window_KeyDown">
    <Window.Resources>
        <SolidColorBrush x:Key="BrushBg"        Color="#1E2620"/>
        <SolidColorBrush x:Key="BrushPanel"     Color="#243029"/>
        <SolidColorBrush x:Key="BrushCard"      Color="#2D3A32"/>
        <SolidColorBrush x:Key="BrushCardHi"    Color="#354539"/>
        <SolidColorBrush x:Key="BrushDivider"   Color="#1A201C"/>
        <SolidColorBrush x:Key="BrushText"      Color="#F0F2EE"/>
        <SolidColorBrush x:Key="BrushTextDim"   Color="#9CA89F"/>
        <SolidColorBrush x:Key="BrushAccent"    Color="#E89B3C"/>
        <SolidColorBrush x:Key="BrushAccentDim" Color="#9A6B2C"/>
        <SolidColorBrush x:Key="BrushAI"        Color="#5BA0D0"/>
        <SolidColorBrush x:Key="BrushHuman"     Color="#8FBE6F"/>

        <Style x:Key="BtnBase" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource BrushCardHi}"/>
            <Setter Property="Foreground" Value="{StaticResource BrushText}"/>
            <Setter Property="BorderBrush" Value="#3D4A40"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3F504A"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BtnAccent" TargetType="Button" BasedOn="{StaticResource BtnBase}">
            <Setter Property="Background" Value="{StaticResource BrushAccent}"/>
            <Setter Property="Foreground" Value="#1E2620"/>
            <Setter Property="BorderBrush" Value="{StaticResource BrushAccent}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F0AC4C"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- 元信息 -->
            <RowDefinition Height="*"/>       <!-- 棋盘 -->
            <RowDefinition Height="Auto"/>   <!-- 控制 -->
        </Grid.RowDefinitions>

        <!-- ========== 元信息 ========== -->
        <Border Grid.Row="0" Background="{StaticResource BrushPanel}" CornerRadius="8" Padding="18,14" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock x:Name="MetaTitle" Text="(空棋谱)"
                               Foreground="{StaticResource BrushAccent}" FontSize="18" FontWeight="Bold" Margin="0,0,0,6"/>
                    <TextBlock x:Name="MetaPlayers" Foreground="{StaticResource BrushText}" FontSize="13" Margin="0,2,0,0"/>
                    <WrapPanel x:Name="MetaChips" Margin="0,8,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <TextBlock x:Name="MetaFileName" Foreground="{StaticResource BrushTextDim}" FontSize="11"
                               TextAlignment="Right"/>
                    <TextBlock x:Name="MetaMoveCount" Foreground="{StaticResource BrushTextDim}" FontSize="11"
                               Margin="0,4,0,0" TextAlignment="Right"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ========== 棋盘 ========== -->
        <Border Grid.Row="1" Background="{StaticResource BrushPanel}" CornerRadius="8" Padding="20">
            <Viewbox Stretch="Uniform">
                <local:BoardControl x:Name="BoardView" Width="660" Height="660"/>
            </Viewbox>
        </Border>

        <!-- ========== 控制条 ========== -->
        <Border Grid.Row="2" Background="{StaticResource BrushPanel}" CornerRadius="8" Padding="18,14" Margin="0,16,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 左：导航按钮 + 步数 -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource BtnBase}" x:Name="BtnFirst" Content="⏮"
                            Width="44" Height="40" ToolTip="回到开局" Click="First_Click" Margin="0,0,6,0"/>
                    <Button Style="{StaticResource BtnBase}" x:Name="BtnPrev" Content="◀"
                            Width="44" Height="40" ToolTip="上一步（←）" Click="Prev_Click" Margin="0,0,6,0"/>
                    <Button Style="{StaticResource BtnBase}" x:Name="BtnNext" Content="▶"
                            Width="44" Height="40" ToolTip="下一步（→）" Click="Next_Click" Margin="0,0,6,0"/>
                    <Button Style="{StaticResource BtnBase}" x:Name="BtnLast" Content="⏭"
                            Width="44" Height="40" ToolTip="跳到终局" Click="Last_Click"/>

                    <Border Margin="14,0,0,0" Padding="12,6" Background="{StaticResource BrushCard}" CornerRadius="4">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="StepCurrentText" Text="0" Foreground="{StaticResource BrushAccent}" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                            <TextBlock Text=" / " Foreground="{StaticResource BrushTextDim}" FontSize="14" VerticalAlignment="Center"/>
                            <TextBlock x:Name="StepTotalText" Text="0" Foreground="{StaticResource BrushText}" FontSize="14" VerticalAlignment="Center"/>
                            <TextBlock Text=" 手" Foreground="{StaticResource BrushTextDim}" FontSize="12" VerticalAlignment="Center" Margin="3,0,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Padding="12,6" Margin="8,0,0,0" Background="{StaticResource BrushCard}" CornerRadius="4">
                        <TextBlock x:Name="WhoPlayText" Foreground="{StaticResource BrushText}" FontSize="12" VerticalAlignment="Center"/>
                    </Border>
                </StackPanel>

                <!-- 中：Slider -->
                <Slider Grid.Column="1" x:Name="StepSlider" Minimum="0"
                        Maximum="100" Value="0" Margin="20,0,20,0"
                        VerticalAlignment="Center"
                        TickPlacement="None" IsMoveToPointEnabled="True"
                        ValueChanged="Slider_ValueChanged"/>

                <!-- 右：动作 -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource BtnAccent}" x:Name="BtnStartFromHere"
                            Content="🎮 从此局面开新对弈" Padding="14,8"
                            ToolTip="关闭复盘窗口并以当前局面开一局新对局（用现执子方）"
                            Click="StartFromHere_Click"/>
                    <Button Style="{StaticResource BtnBase}" x:Name="BtnClose" Content="✕ 关闭"
                            Padding="14,8" Margin="8,0,0,0" Click="Close_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
