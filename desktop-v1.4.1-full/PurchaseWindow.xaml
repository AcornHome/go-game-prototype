<Window x:Class="GoGame.PurchaseWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="购买提示次数" Height="820" Width="660"
        MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Background="#1E2620" FontFamily="Segoe UI, Microsoft YaHei UI">
    <Window.Resources>
        <!-- 与主界面一致的墨绿 + 琥珀金配色 -->
        <SolidColorBrush x:Key="BrushBg"        Color="#1E2620"/>
        <SolidColorBrush x:Key="BrushPanel"     Color="#243029"/>
        <SolidColorBrush x:Key="BrushCard"      Color="#2D3A32"/>
        <SolidColorBrush x:Key="BrushCardHi"    Color="#354539"/>
        <SolidColorBrush x:Key="BrushText"      Color="#F0F2EE"/>
        <SolidColorBrush x:Key="BrushTextDim"   Color="#9CA89F"/>
        <SolidColorBrush x:Key="BrushTextMute"  Color="#6F7B73"/>
        <SolidColorBrush x:Key="BrushAccent"    Color="#E89B3C"/>
        <SolidColorBrush x:Key="BrushDanger"    Color="#D8584A"/>
        <SolidColorBrush x:Key="BrushHuman"     Color="#8FBE6F"/>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource BrushText}"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <!-- 套餐卡片：默认暗底，选中时金边高亮 -->
        <Style x:Key="PlanCard" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource BrushCard}"/>
            <Setter Property="BorderBrush" Value="#3D4A40"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Padding" Value="18,14"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource BrushCardHi}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TextBoxDark" TargetType="TextBox">
            <Setter Property="Background" Value="#1A201C"/>
            <Setter Property="Foreground" Value="{StaticResource BrushText}"/>
            <Setter Property="BorderBrush" Value="#3D4A40"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CaretBrush" Value="{StaticResource BrushAccent}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource BrushAccent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BtnBase" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource BrushCardHi}"/>
            <Setter Property="Foreground" Value="{StaticResource BrushText}"/>
            <Setter Property="BorderBrush" Value="#3D4A40"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#45524A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BtnPrimary" TargetType="Button" BasedOn="{StaticResource BtnBase}">
            <Setter Property="Background" Value="#C77F25"/>
            <Setter Property="Foreground" Value="#FFF5E2"/>
            <Setter Property="BorderBrush" Value="#E89B3C"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- 标题 -->
            <RowDefinition Height="*"/>      <!-- 内容（可滚动） -->
            <RowDefinition Height="Auto"/>   <!-- 底部按钮 -->
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <Border Grid.Row="0" Background="{StaticResource BrushPanel}" Padding="24,18">
            <StackPanel>
                <TextBlock Text="💡 购买提示次数" FontSize="20" FontWeight="Bold"
                           Foreground="{StaticResource BrushAccent}"/>
                <TextBlock Text="新用户赠送 100 次；用完后按需购买，或一次买断永久使用"
                           FontSize="12" Foreground="{StaticResource BrushTextDim}" Margin="0,6,0,0"/>
            </StackPanel>
        </Border>

        <!-- 内容 -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="24,16,24,8">
            <StackPanel>

                <!-- 当前余额 -->
                <Border Background="{StaticResource BrushPanel}" CornerRadius="10" Padding="20,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="当前余额" FontSize="12" Foreground="{StaticResource BrushTextDim}"/>
                            <TextBlock x:Name="BalanceText" Text="100 次" FontSize="30" FontWeight="Bold"
                                       Foreground="{StaticResource BrushAccent}" Margin="0,4,0,0"/>
                            <TextBlock x:Name="BalanceDetailText" Text="" FontSize="11"
                                       Foreground="{StaticResource BrushTextMute}" Margin="0,6,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                            <TextBlock Text="你的用户 ID" FontSize="11" Foreground="{StaticResource BrushTextDim}"
                                       HorizontalAlignment="Right"/>
                            <TextBlock x:Name="UserIdText" Text="—" FontSize="16" FontWeight="Bold"
                                       Foreground="{StaticResource BrushText}" HorizontalAlignment="Right" Margin="0,4,0,0"/>
                            <TextBlock Text="购买时提供此 ID" FontSize="10" Foreground="{StaticResource BrushTextMute}"
                                       HorizontalAlignment="Right" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 套餐选择 -->
                <TextBlock Text="选择套餐" FontSize="12" Foreground="{StaticResource BrushTextDim}" Margin="0,20,0,8"/>

                <Button x:Name="PlanBasic" Style="{StaticResource PlanCard}" Tag="1" Click="Plan_Click">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="体验包" FontSize="15" FontWeight="SemiBold"/>
                            <TextBlock Text="10 次提示" FontSize="12" Foreground="{StaticResource BrushTextDim}" Margin="0,3,0,0"/>
                            <TextBlock x:Name="UnitBasic" Text="" FontSize="11" Foreground="{StaticResource BrushTextMute}" Margin="0,4,0,0"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="$1" FontSize="26" FontWeight="Bold"
                                   Foreground="{StaticResource BrushAccent}" VerticalAlignment="Center"/>
                    </Grid>
                </Button>

                <Button x:Name="PlanStandard" Style="{StaticResource PlanCard}" Tag="2" Click="Plan_Click">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="常练包" FontSize="15" FontWeight="SemiBold"/>
                                <Border Background="{StaticResource BrushAccent}" CornerRadius="4" Padding="6,2" Margin="8,0,0,0">
                                    <TextBlock Text="推荐" FontSize="10" FontWeight="Bold" Foreground="#1E2620"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="200 次提示" FontSize="12" Foreground="{StaticResource BrushTextDim}" Margin="0,3,0,0"/>
                            <TextBlock x:Name="UnitStandard" Text="" FontSize="11" Foreground="{StaticResource BrushTextMute}" Margin="0,4,0,0"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="$5" FontSize="26" FontWeight="Bold"
                                   Foreground="{StaticResource BrushAccent}" VerticalAlignment="Center"/>
                    </Grid>
                </Button>

                <Button x:Name="PlanPro" Style="{StaticResource PlanCard}" Tag="3" Click="Plan_Click">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="深度包" FontSize="15" FontWeight="SemiBold"/>
                            <TextBlock Text="1000 次提示" FontSize="12" Foreground="{StaticResource BrushTextDim}" Margin="0,3,0,0"/>
                            <TextBlock x:Name="UnitPro" Text="" FontSize="11" Foreground="{StaticResource BrushTextMute}" Margin="0,4,0,0"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="$10" FontSize="26" FontWeight="Bold"
                                   Foreground="{StaticResource BrushAccent}" VerticalAlignment="Center"/>
                    </Grid>
                </Button>

                <Button x:Name="PlanLifetime" Style="{StaticResource PlanCard}" Tag="4" Click="Plan_Click">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="永久包" FontSize="15" FontWeight="SemiBold"/>
                            <TextBlock Text="永久无限次 · 一次买断" FontSize="12" Foreground="{StaticResource BrushTextDim}" Margin="0,3,0,0"/>
                            <TextBlock Text="再也不用管次数" FontSize="11" Foreground="{StaticResource BrushTextMute}" Margin="0,4,0,0"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="$100" FontSize="26" FontWeight="Bold"
                                   Foreground="{StaticResource BrushAccent}" VerticalAlignment="Center"/>
                    </Grid>
                </Button>

                <!-- 购买流程说明 -->
                <Border Background="{StaticResource BrushPanel}" CornerRadius="10" Padding="18,16" Margin="0,14,0,0">
                    <StackPanel>
                        <TextBlock Text="购买流程" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{StaticResource BrushAccent}"/>
                        <TextBlock x:Name="BuyStepText" Text="" FontSize="12"
                                   Foreground="{StaticResource BrushTextDim}" Margin="0,10,0,0"
                                   TextWrapping="Wrap"/>
                        <Button x:Name="CopyMailBtn" Style="{StaticResource BtnBase}" Content="📋 复制购买邮箱"
                                Height="36" Margin="0,12,0,0" Click="CopyMail_Click"/>
                    </StackPanel>
                </Border>

                <!-- 激活码兑换 -->
                <Border Background="{StaticResource BrushPanel}" CornerRadius="10" Padding="18,16" Margin="0,14,0,20">
                    <StackPanel>
                        <TextBlock Text="已有激活码？" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{StaticResource BrushAccent}"/>
                        <TextBlock Text="付款后你会收到激活码，粘贴到下面即可到账（激活码绑定你的用户 ID，仅限本人使用）"
                                   FontSize="11" Foreground="{StaticResource BrushTextDim}" Margin="0,6,0,10"
                                   TextWrapping="Wrap"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="KeyBox" Grid.Column="0" Style="{StaticResource TextBoxDark}"
                                     Height="42" MaxLength="30" TextChanged="KeyBox_TextChanged"/>
                            <Button x:Name="RedeemBtn" Grid.Column="1" Style="{StaticResource BtnPrimary}"
                                    Content="兑换" Width="96" Height="42" Margin="10,0,0,0"
                                    IsEnabled="False" Click="Redeem_Click"/>
                        </Grid>
                        <TextBlock x:Name="RedeemMsgText" Text="" FontSize="12" Margin="0,10,0,0"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- 底部 -->
        <Border Grid.Row="2" Background="{StaticResource BrushPanel}" Padding="24,14">
            <Grid>
                <TextBlock x:Name="SelectedPlanText" Text="选择一个套餐查看购买方式" FontSize="12"
                           Foreground="{StaticResource BrushTextDim}" VerticalAlignment="Center"/>
                <Button x:Name="CloseBtn" Style="{StaticResource BtnBase}" Content="关闭"
                        Width="100" Height="38" HorizontalAlignment="Right" Click="Close_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>
